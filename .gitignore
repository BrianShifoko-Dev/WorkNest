# ----------------------------------------
# Node / Next.js / React Standard Ignores
# ----------------------------------------

# dependencies
/node_modules
/.pnp
.pnp.js

# build outputs
.next/
out/
dist/
build/
.cache/
coverage/

# production
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
*.pem
*.key
*.crt
*.swp
*.swo
*.zip
*.tar
*.gz
*.rar

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# optional: TypeScript
*.tsbuildinfo

# optional: test coverage
coverage/
jest-cache/
jest-html-reporters-*

# Next.js static export
.next/
out/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# optional: local data, uploads, or backups
uploads/
temp/
backup/

# optional: lock files (if switching between managers)
package-lock.json
yarn.lock
pnpm-lock.yaml
